{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "authoritativeFormat",
    "reason",
    "sourcePath",
    "sourceSha256",
    "finalVideo",
    "youtubeTitle",
    "draftVerified",
    "qcSummary"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["uploaded_draft", "needs_assets", "needs_review", "rejected", "duplicate", "failed"]
    },
    "authoritativeFormat": {
      "type": "string",
      "enum": ["split_short", "caption_story", "reject"]
    },
    "reason": { "type": "string" },
    "sourcePath": { "type": "string" },
    "sourceSha256": { "type": "string" },
    "finalVideo": { "type": "string" },
    "youtubeTitle": { "type": "string" },
    "draftVerified": { "type": "boolean" },
    "qcSummary": { "type": "string" }
  }
}
